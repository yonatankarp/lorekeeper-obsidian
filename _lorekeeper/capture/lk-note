#!/bin/sh
# Saves a quick note to the current session, the way Lorekeeper's note box does (see lib/session.js, which matches it).
#   lk-note [--vault DIR] [--me NAME] [--next | --here] [--dialog | --stdin | TEXT...]
# --next starts the next session (with no text: just starts it). --here keeps a quiet session without asking.
# --dialog asks for the note in a system box; --stdin reads it from standard input.
# Party play: your name comes from --me (--me "" forces solo) or this vault's line in ~/.config/lorekeeper/me.tsv. Then the
# note goes to Sessions/Session N/<name>.md, or, when it starts with ~, to Private/<name>/Sessions/Session N.md (lib/party.js).
# With no name, a ~ note in a vault that shows party play (Private/ or a Sessions/Session N/ folder) is refused (exit 2).
# Exit: 0 saved (prints the session's path), 1 cancelled, 2 usage or setup error,
# 3 the session went quiet (no change in 12 hours) and there's no dialog to ask: rerun with --next or --here,
# 4 a ~ note refused because no character is picked (with --dialog or --stdin it also shows a dialog with the note).
set -eu

vault=${LK_VAULT:-$(cd "$(dirname "$0")/../.." && pwd)}
mode=args
quiet=ask
me=
me_set=0
while [ $# -gt 0 ]; do
  case $1 in
    --vault)
      [ $# -ge 2 ] || { echo "lk-note: --vault needs a folder" >&2; exit 2; }
      vault=$2
      shift 2
      ;;
    --me)
      [ $# -ge 2 ] || { echo "lk-note: --me needs a name" >&2; exit 2; }
      me=$2
      me_set=1
      shift 2
      ;;
    --next) quiet=next; shift ;;
    --here) quiet=here; shift ;;
    --dialog) mode=dialog; shift ;;
    --stdin) mode=stdin; shift ;;
    --) shift; break ;;
    -*) echo "lk-note: unknown option $1" >&2; exit 2 ;;
    *) break ;;
  esac
done

template=$vault/_lorekeeper/templates/session.md
[ -f "$template" ] || { echo "lk-note: $vault isn't a Lorekeeper vault (no _lorekeeper/templates/session.md)" >&2; exit 2; }

if [ "$me_set" = 0 ]; then
  me_file=${XDG_CONFIG_HOME:-$HOME/.config}/lorekeeper/me.tsv
  if [ -f "$me_file" ]; then
    # the vault's absolute path as the app wrote it; also the symlink-free spelling (macOS /var vs /private/var), the
    # folder as passed, and on Windows (Git Bash) the C:/... and C:\... spellings
    win=$(cd "$vault" && pwd -W 2>/dev/null) || win=
    win_back=$(printf '%s' "$win" | sed 's|/|\\|g')
    for vault_abs in "$(cd "$vault" && pwd)" "$(cd "$vault" && pwd -P)" "$vault" "$win" "$win_back"; do
      [ -n "$vault_abs" ] || continue
      me=$(V=$vault_abs awk -F'\t' '$1 == ENVIRON["V"] {print $2; exit}' "$me_file" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      [ -z "$me" ] || break
    done
  fi
fi

has_dialog() {
  [ "${LK_NO_DIALOG:-}" != 1 ] && { command -v osascript >/dev/null 2>&1 || command -v zenity >/dev/null 2>&1; }
}

# ask PROMPT: prints the typed text; fails when cancelled.
ask() {
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'on run argv' -e 'tell application "System Events"' -e 'activate' \
      -e 'text returned of (display dialog (item 1 of argv) default answer "" with title "Lorekeeper")' \
      -e 'end tell' -e 'end run' "$1"
  else
    zenity --entry --title=Lorekeeper --text="$1"
  fi
}

# refused MESSAGE: shows why a note wasn't saved.
refused() {
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'on run argv' -e 'tell application "System Events"' -e 'activate' \
      -e 'display alert "Lorekeeper" message (item 1 of argv)' -e 'end tell' -e 'end run' "$1" >/dev/null
  else
    zenity --error --no-markup --title=Lorekeeper --text="$1"
  fi
}

# front_app: the frontmost app's name on macOS (LK_FRONT_APP overrides it), else nothing.
front_app() {
  if [ -n "${LK_FRONT_APP+x}" ]; then
    printf '%s' "$LK_FRONT_APP"
  elif command -v osascript >/dev/null 2>&1; then
    osascript -e 'tell application "System Events" to name of first application process whose frontmost is true' 2>/dev/null || true
  fi
}

# urlencode TEXT: every byte as %XX, which is always a valid URL encoding.
urlencode() {
  printf '%s' "$1" | od -An -tx1 -v | tr -d ' \n' | sed 's/../%&/g'
}

# start_next N: succeeds when the player picks Start Session N+1.
start_next() {
  next=$(($1 + 1))
  if command -v osascript >/dev/null 2>&1; then
    answer=$(osascript -e 'on run argv' -e 'tell application "System Events"' -e 'activate' \
      -e 'button returned of (display dialog (item 1 of argv) buttons {(item 2 of argv), (item 3 of argv)} default button 2 with title "Lorekeeper")' \
      -e 'end tell' -e 'end run' "Session $1 went quiet over 12 hours ago." "Keep Session $1" "Start Session $next") || return 1
    [ "$answer" = "Start Session $next" ]
  else
    zenity --question --title=Lorekeeper --text="Session $1 went quiet over 12 hours ago." \
      --ok-label="Start Session $next" --cancel-label="Keep Session $1"
  fi
}

case $mode in
  dialog)
    if [ "$(front_app)" = Obsidian ]; then # the smart hotkey: Quick note inside Obsidian, with [[ suggestions
      open_cmd=${LK_OPEN:-open}
      "$open_cmd" "obsidian://quickadd?choice=$(urlencode "Quick note")&vault=$(urlencode "$(basename "$vault")")"
      exit 0
    fi
    has_dialog || { echo "lk-note: --dialog needs osascript (macOS) or zenity (Linux)" >&2; exit 2; }
    text=$(ask "Note") || exit 1
    ;;
  stdin) text=$(cat) ;;
  *) text="$*" ;;
esac
text=$(printf '%s' "$text" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')

# Fail closed: with no name, a ~ note would be saved into the shared session page. Refuse it when the vault shows party
# play (a Private/ folder or a Sessions/Session N/ folder); a solo vault keeps it as typed, and other notes save solo.
party_signs() {
  [ -d "$vault/Private" ] && return 0
  for d in "$vault"/Sessions/Session\ */; do
    [ -d "$d" ] || continue
    d=${d%/}
    case ${d##*/Session } in '' | *[!0-9]*) ;; *) return 0 ;; esac
  done
  return 1
}
if [ -z "$me" ]; then
  case $text in
    '~~'*) ;;
    '~'*)
      if [ -n "$(printf '%s' "${text#\~}" | sed 's/^ //')" ] && party_signs; then
        echo "lk-note: pick your character in Obsidian first (this note starts with ~, so it would be shared)" >&2
        if [ "$mode" != args ] && has_dialog; then
          refused "Pick your character in Obsidian first: this note starts with ~, so it would be shared. Your note: $text" || true
        fi
        exit 4
      fi
      ;;
  esac
fi

# fresh FILE: succeeds when FILE changed within the last 12 hours.
fresh() {
  [ -f "$1" ] && [ -z "$(find "$1" -mmin +720)" ]
}

# others_fresh N NAME: succeeds when a teammate's file in Session N/ is fresh (the page itself counts only when there are
# no part files at all); sets mine_exists to 1 or 0.
others_fresh() {
  mine_exists=0
  any_other=0
  found=1
  for f in "$vault/Sessions/Session $1"/*.md; do
    [ -f "$f" ] || continue
    if [ "$f" = "$vault/Sessions/Session $1/$2.md" ]; then
      mine_exists=1
    else
      any_other=1
      if fresh "$f"; then found=0; fi
    fi
  done
  if [ "$mine_exists" = 0 ] && [ "$any_other" = 0 ] && fresh "$vault/Sessions/Session $1.md"; then found=0; fi
  return $found
}

# sed_escape TEXT: TEXT safe inside a s|..|..| replacement.
sed_escape() {
  printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}

# write_party: the party-mode save (me is set).
write_party() {
  is_private=0
  case $text in
    '~~'*) ;;
    '~'*)
      is_private=1
      text=$(printf '%s' "${text#\~}" | sed 's/^ //')
      ;;
  esac
  if [ "$quiet" = next ]; then
    if [ "$n" -eq 0 ]; then
      n=1
    elif others_fresh "$n" "$me" && [ "$mine_exists" = 0 ]; then
      :
    else
      n=$((n + 1))
    fi
  elif [ -z "$text" ]; then
    exit 0
  elif [ "$n" -eq 0 ]; then
    n=1
  elif [ "$quiet" = ask ]; then
    mine="$vault/Sessions/Session $n/$me.md"
    if [ -f "$mine" ]; then
      if fresh "$mine"; then is_quiet=0; else is_quiet=1; fi
    elif others_fresh "$n" "$me"; then
      is_quiet=0
    else
      is_quiet=1
    fi
    if [ "$is_quiet" = 1 ]; then
      if [ "$mode" = args ] || ! has_dialog; then
        echo "lk-note: Session $n went quiet over 12 hours ago; rerun with --next or --here" >&2
        exit 3
      fi
      if start_next "$n"; then n=$((n + 1)); fi
    fi
  fi

  page="$vault/Sessions/Session $n.md"
  if [ ! -e "$page" ]; then
    mkdir -p "$vault/Sessions"
    sed -e "s/{{session}}/$n/g" -e "s/{{date}}/$(date +%Y-%m-%d)/g" "$template" >"$page"
  fi
  if [ "$is_private" = 1 ]; then
    file="$vault/Private/$me/Sessions/Session $n.md"
  else
    file="$vault/Sessions/Session $n/$me.md"
  fi
  if [ ! -e "$file" ]; then
    mkdir -p "$(dirname "$file")"
    if [ "$me" = DM ]; then author=DM; else author="\"[[$me]]\""; fi
    sed -e "s|{{session}}|$n|g" -e "s|{{date}}|$(date +%Y-%m-%d)|g" -e "s|{{author}}|$(sed_escape "$author")|g" \
      "$vault/_lorekeeper/templates/session-part.md" >"$file"
  fi
  if [ -n "$text" ]; then
    if [ -s "$file" ] && [ -n "$(tail -c 1 "$file")" ]; then printf '\n' >>"$file"; fi
    printf '%s\n' "- $(date +%H:%M) $text" >>"$file"
  fi
  printf '%s\n' "$file"
}

latest=0
for p in "$vault"/Sessions/Session\ *; do
  [ -e "$p" ] || continue
  n=${p##*/Session }
  n=${n%.md}
  case $n in '' | *[!0-9]*) continue ;; esac
  if [ "$n" -gt "$latest" ]; then latest=$n; fi
done

if [ -n "$me" ]; then
  n=$latest
  write_party
  exit 0
fi

n=$latest
file="$vault/Sessions/Session $n.md"
if [ "$quiet" = next ]; then
  n=$((n + 1))
elif [ -z "$text" ]; then
  exit 0
elif [ "$n" -eq 0 ]; then
  n=1
elif [ "$quiet" = ask ] && [ -f "$file" ] && [ -n "$(find "$file" -mmin +720)" ]; then
  if [ "$mode" = args ] || ! has_dialog; then
    echo "lk-note: Session $n went quiet over 12 hours ago; rerun with --next or --here" >&2
    exit 3
  fi
  if start_next "$n"; then n=$((n + 1)); fi
fi

file="$vault/Sessions/Session $n.md"
if [ ! -e "$file" ]; then
  mkdir -p "$vault/Sessions"
  sed -e "s/{{session}}/$n/g" -e "s/{{date}}/$(date +%Y-%m-%d)/g" "$template" >"$file"
fi
if [ -n "$text" ]; then
  if [ -s "$file" ] && [ -n "$(tail -c 1 "$file")" ]; then printf '\n' >>"$file"; fi
  printf '%s\n' "- $(date +%H:%M) $text" >>"$file"
fi
printf '%s\n' "$file"
